# JOOP COMPAGNY - Production
# Remplir uniquement avec des valeurs propres a JOOP COMPAGNY.
# Ne pas reutiliser la base, les secrets JWT, ni les URL d'un autre site.

# Database - obligatoire
# Utiliser une nouvelle base PostgreSQL/Neon dediee a JOOP COMPAGNY.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/joop_compagny_prod?sslmode=require&schema=public"

# App URLs - obligatoires
# En production, garder la meme URL publique de reference.
NEXT_PUBLIC_APP_URL="https://www.joop-compagny.com"
NEXT_PUBLIC_APP_NAME="JOOP COMPAGNY"
NEXT_PUBLIC_SITE_URL="https://www.joop-compagny.com"

# Auth - obligatoires
# Generer deux secrets differents, longs et aleatoires.
JWT_ACCESS_SECRET="replace-with-a-64-plus-char-random-secret-for-joop-only"
JWT_REFRESH_SECRET="replace-with-a-second-64-plus-char-random-secret-for-joop-only"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# PayDunya - obligatoires si paiements actifs
PAYDUNYA_MASTER_KEY="joop-prod-master-key"
PAYDUNYA_PRIVATE_KEY="joop-prod-private-key"
PAYDUNYA_TOKEN="joop-prod-token"
PAYDUNYA_MODE="live"
PAYDUNYA_CALLBACK_URL="https://www.joop-compagny.com/api/webhooks/paydunya"
PAYDUNYA_RETURN_URL="https://www.joop-compagny.com/store/orders"
PAYDUNYA_CANCEL_URL="https://www.joop-compagny.com/store/cart"

# Cloudinary - obligatoires si upload image admin
CLOUDINARY_CLOUD_NAME="dlfytqzpw"
CLOUDINARY_API_KEY="joop-cloudinary-api-key"
CLOUDINARY_API_SECRET="joop-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dlfytqzpw"
NEXT_PUBLIC_CLOUDINARY_PRESET="joop_compagny"

# Email - obligatoire si mot de passe oublie / emails transactionnels
SMTP_FROM="contact@joop-compagny.com"
SMTP_PASS="smtp-or-app-password-for-joop-mailbox"

# Seed users - optionnel
# Renseigner uniquement si vous voulez creer un compte admin de bootstrap pendant le seed.
SEED_ADMIN_EMAIL="admin@joop-compagny.com"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_USERS="false"
SEED_STAFF_EMAIL=""
SEED_STAFF_PASSWORD=""
SEED_CUSTOMER_EMAIL=""
SEED_CUSTOMER_PASSWORD=""

# Logging - recommande
LOG_LEVEL="info"

# Optional
REDIS_URL=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
