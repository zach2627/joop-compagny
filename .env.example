# Copy this file to .env and fill in the values

# PostgreSQL connection string
# Replace USER, PASSWORD, HOST, PORT and DATABASE with your real values.
# Example: postgresql://postgres:mysecretpassword@localhost:5432/joop_compagny_prod?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/joop_compagny_db?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JOOP COMPAGNY"
NEXT_PUBLIC_SITE_URL="https://joop-compagny.com"

# Auth
JWT_ACCESS_SECRET="your-super-secret-access-key-min-64-chars-long-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-64-chars-long-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# PayDunya
PAYDUNYA_MASTER_KEY="your-master-key"
PAYDUNYA_PRIVATE_KEY="your-private-key"
PAYDUNYA_TOKEN="your-token"
PAYDUNYA_MODE="test"
PAYDUNYA_CALLBACK_URL="https://joop-compagny.com/api/webhooks/paydunya"
PAYDUNYA_RETURN_URL="https://joop-compagny.com/store/orders"
PAYDUNYA_CANCEL_URL="https://joop-compagny.com/store/cart"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="info"

# Storage (optional)
CLOUDINARY_CLOUD_NAME="dlfytqzpw"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dlfytqzpw"
NEXT_PUBLIC_CLOUDINARY_PRESET="joop_compagny"

# Email
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="contact@joop-compagny.com"

# Seed users (optional)
# Set SEED_ADMIN_PASSWORD to bootstrap an admin account on seed.
# Set SEED_DEMO_USERS=true only if you explicitly want demo staff/customer accounts.
SEED_ADMIN_EMAIL="admin@joop-compagny.com"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_USERS="false"
SEED_STAFF_EMAIL="atelier@joop-compagny.com"
SEED_STAFF_PASSWORD=""
SEED_CUSTOMER_EMAIL="cliente@example.sn"
SEED_CUSTOMER_PASSWORD=""

# Analytics / SEO (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
